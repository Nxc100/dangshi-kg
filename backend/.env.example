# ===== Flask =====
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# JWT 有效期（秒），定稿 2 小时
JWT_ACCESS_TOKEN_EXPIRES=7200
FLASK_DEBUG=1

# ===== Neo4j（Neo4j Desktop 本地 DBMS，5.x/2026.x）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ===== 初始管理员（init_db.py 读取；未设置则生成随机密码打印终端一次）=====
ADMIN_INIT_PASSWORD=

# ===== LLM 增强模块（M-LLM，唯一可选外部服务；未配置即关闭）=====
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=5
